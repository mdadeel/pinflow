# LLM provider configuration
# The AI metadata generator (analyzer) calls an LLM. OpenRouter is the default
# (OpenAI-chat compatible). Set OPENROUTER_API_KEY to enable it.
OPENROUTER_API_KEY=

# To use any other provider from mini.md, set the LLM_* overrides below.
# LLM_API_KEY / LLM_MODEL fall back to the OPENROUTER_* values when unset.
# LLM_BASE_URL is the full endpoint for "openai" protocol, or the base origin
# (we append /v1/messages) for "anthropic" protocol.
#
# OpenAI-chat compatible (same response shape as OpenRouter):
#   LLM_PROTOCOL=openai
#   LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions   # or z.ai, pollinations, nara, moonshot, dashscope, ...
#   LLM_API_KEY=...
#   LLM_MODEL=google/gemini-2.5-flash
#
# Anthropic Messages compatible (Aerolink, FreeModel, OpenCode Zen):
#   LLM_PROTOCOL=anthropic
#   LLM_BASE_URL=https://capi.aerolink.lat        # origin only; /v1/messages is appended
#   LLM_API_KEY=...
#   LLM_MODEL=claude-...

# Multi-provider failover (optional but recommended). JSON list of providers;
# when one key is out of credits / rate-limited, the next working key is used
# automatically. Each entry: {"name","protocol"("openai"|"anthropic"),
# "base_url","api_key","model"}. See mini.md for the full key inventory.
# Example (single provider):     LLM_PROVIDERS=[{"name":"p1","protocol":"openai","base_url":"https://openrouter.ai/api/v1/chat/completions","api_key":"...","model":"google/gemini-2.5-flash"}]
# Example (anthropic origin):    LLM_PROVIDERS=[{"name":"a1","protocol":"anthropic","base_url":"https://capi.aerolink.lat","api_key":"...","model":"claude-sonnet-4-6"}]
# Leave empty to use the single legacy LLM_* / OPENROUTER_* settings above.
LLM_PROVIDERS=
ANALYSIS_WORKERS=3

# Pinterest (only needed to actually publish pins)
# Get your access token from https://developers.pinterest.com/
# PINTEREST_ACCESS_TOKEN=
# The board (mandatory) for PINTEREST_ACCESS_TOKEN:
# PINTEREST_BOARD_ID=

# CORS origins (comma-separated for multiple domains)
# ALLOWED_ORIGINS=http://localhost:3000

# WebSocket secret (leave empty to disable auth in dev)
# WS_SECRET=

# API key authentication (leave empty to disable in dev)
# When set, all API requests must include X-API-Key header
API_KEY=

# Frontend API key (must match API_KEY above)
# NEXT_PUBLIC_API_KEY=
